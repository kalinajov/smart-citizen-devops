server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Liveness/readiness target. Answers without touching the backend or disk,
    # so a probe failure means nginx itself is down.
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    # gzip text assets — Vite's hashed bundles compress well
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Cache hashed assets aggressively; never cache index.html
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location = /index.html {
        add_header Cache-Control "no-store";
    }

    # Proxy API to the backend.
    # BACKEND_SCHEME lets one image serve every environment: http for the
    # Compose network and in-cluster Services, https for Azure Container Apps.
    #
    # The location and the proxy_pass target share the /api/v1 prefix on
    # purpose. Because the path is not rewritten, FastAPI's absolute redirects
    # (e.g. /api/v1/categories -> /api/v1/categories/) are already correct for
    # the browser and need no proxy_redirect fix-up.
    location /api/v1/ {
        proxy_pass         ${BACKEND_SCHEME}://${BACKEND_FQDN}/api/v1/;
        proxy_http_version 1.1;
        proxy_set_header   Host                ${BACKEND_FQDN};
        proxy_set_header   X-Forwarded-For     $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto   $scheme;
        proxy_set_header   X-Real-IP           $remote_addr;
        proxy_ssl_server_name on;
        proxy_read_timeout 120s;
        client_max_body_size 6m;
    }

    # Backend-served upload assets (PDFs/images uploaded by users).
    location /static/ {
        proxy_pass         ${BACKEND_SCHEME}://${BACKEND_FQDN}/static/;
        proxy_http_version 1.1;
        proxy_set_header   Host                ${BACKEND_FQDN};
        proxy_ssl_server_name on;
    }

    # SPA fallback for React Router
    location / {
        try_files $uri $uri/ /index.html;
    }
}
